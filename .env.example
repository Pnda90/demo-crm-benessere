# Copia questo file in .env.local e inserisci i valori del TUO progetto Supabase.
# Qui vanno SOLO valori pubblici (finiscono nel browser): la sicurezza è garantita dalla RLS.
# Le chiavi segrete (service_role, Stripe, Gemini, Anthropic) NON vanno qui:
# si impostano con `npx supabase secrets set NOME=valore` e le leggono solo le Edge Functions.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
